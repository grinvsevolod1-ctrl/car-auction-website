# === PostgreSQL ===
# Строка подключения к вашей базе на VPS
DATABASE_URL="postgresql://ignis:пароль@localhost:5432/ignis?schema=public"

# === Авторизация ===
# Секрет для подписи сессионных JWT. Сгенерируйте своим значением:
#   openssl rand -base64 32
AUTH_SECRET="замените-на-длинный-случайный-секрет"

# === Первичный администратор (используется командой seed) ===
ADMIN_EMAIL="admin@ignis.by"
ADMIN_PASSWORD="смените-этот-пароль"

# === Базовый адрес сайта (для ссылок в письмах и проверки Origin) ===
APP_URL="https://ваш-домен.by"

# === SMTP для отправки писем (подтверждение email, уведомления) ===
# Если не заданы — письма пишутся в консоль сервера (удобно для отладки).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # true для порта 465
SMTP_USER="no-reply@ваш-домен.by"
SMTP_PASS="пароль-smtp"
SMTP_FROM="IGNIS <no-reply@ваш-домен.by>"

# === Параметры аукциона (необязательно, есть значения по умолчанию) ===
# REQUIRE_EMAIL_VERIFICATION="true"   # false — разрешить торги без подтверждения email
# VERIFICATION_TTL_HOURS="48"
# ANTISNIPE_WINDOW_SEC="120"          # окно антиснайпинга
# ANTISNIPE_EXTEND_SEC="120"          # на сколько продлевать торги
# CATALOG_PAGE_SIZE="12"              # лотов на странице каталога
